{
    "name": "rnsharma93/laravel-email-sandbox",
    "description": "Production-ready self-hosted email testing driver for Laravel with attachment preview and secure dashboard.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ram Sharma"
        }
    ],
    "autoload": {
        "psr-4": {
            "Ram\\EmailSandbox\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ram\\EmailSandbox\\EmailSandboxServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "symfony/mailer": "^6.2|^7.0",
        "symfony/mime": "^6.2|^7.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}