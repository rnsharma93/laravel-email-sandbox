{
    "name": "rnsharma93/laravel-email-sandbox",
    "description": "Self-hosted email testing driver & dashboard for Laravel — capture and preview outgoing emails on staging without sending real mail.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "email",
        "mail",
        "mailer",
        "sandbox",
        "testing",
        "staging",
        "mailpit",
        "mailtrap",
        "email-preview",
        "mail-driver"
    ],
    "homepage": "https://github.com/rnsharma93/laravel-email-sandbox",
    "support": {
        "issues": "https://github.com/rnsharma93/laravel-email-sandbox/issues",
        "source": "https://github.com/rnsharma93/laravel-email-sandbox"
    },
    "authors": [
        {
            "name": "Ram Sharma",
            "email": "rns6393@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Ram\\EmailSandbox\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ram\\EmailSandbox\\EmailSandboxServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "symfony/mailer": "^6.2|^7.0",
        "symfony/mime": "^6.2|^7.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}